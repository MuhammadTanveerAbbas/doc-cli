{
  "name": "doc-cli-assistant",
  "version": "0.1.0",
  "description": "Cross platform developer and system maintenance command line assistant",
  "type": "module",
  "license": "MIT",
  "bin": {
    "doc-cli": "bin/doccli.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/doc-cli.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "docs:commands": "tsx scripts/genCommandDocs.ts",
    "check:style": "tsx scripts/checkStyle.ts",
    "smoke": "node bin/doccli.js version",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:style && pnpm test && pnpm build && pnpm smoke",
    "release:check": "tsx scripts/releaseCheck.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "systeminformation": "^5.33.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
